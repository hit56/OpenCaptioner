# 复制为 .env.local 后填写本机/生产配置：
#   cp .env.example .env.local
# .env.local 已 gitignore，勿提交。
# SMTP 请使用 smtp.env.example → smtp.env。
# 启动前 export 的变量优先于本文件（例如 export LLM_URL=... && bash run_gateway.sh）。

# --- 出口代理（访问 YouTube / 外网 OAuth 时需要）---
# http_proxy=http://user:pass@proxy-host:3120
# https_proxy=http://user:pass@proxy-host:3120
# ftp_proxy=http://user:pass@proxy-host:3120
# 额外直连主机（逗号分隔），会与 127.0.0.1,localhost 合并
# NO_PROXY=10.0.0.1,.internal.example.com
# YouTube 媒体走 googlevideo CDN。若上面的 https_proxy 只能打开 youtube.com
# 而 CDN TLS 超时，单独指定能连通 googlevideo 的代理：
# YTDLP_PROXY=http://user:pass@proxy-host:3120
# 可选：显式指定 Node（网关 PATH 通常不含 nvm）
# YTDLP_NODE_PATH=/path/to/node
# 推荐：自建 YouTube 下载服务（Bearer 鉴权；密钥勿提交 git）
# YOUTUBE_DOWNLOAD_API_URL=http://your-download-host:8078/api/youtube/download/sync
# YOUTUBE_DOWNLOAD_API_TOKEN=your-secret-token
# YOUTUBE_DOWNLOAD_API_TIMEOUT=600
# YOUTUBE_DOWNLOAD_API_PROXY=http://user:pass@proxy-host:3120

# --- 远程服务 ---
PUNCT_URL=http://127.0.0.1:8080/v1/chat/completions
LLM_URL=http://127.0.0.1:8081/v1
# EMBED_URL=http://127.0.0.1:8082/v1
# BILI_META_LLM_URL=http://127.0.0.1:8081/v1
# BILI_COVER_IMAGE_URL=http://127.0.0.1:8083

# --- 模型路径（按本机实际位置填写）---
QWEN3_OFFLINE_MODEL_PATH=/path/to/Qwen3-ASR-1.7B
FORCED_ALIGNER_MODEL_PATH=/path/to/Qwen3-ForcedAligner-0.6B
LLM_MODEL_PATH=/path/to/Qwen3-8B
EMBED_MODEL_PATH=/path/to/Qwen3-Embedding-8B
# PUNCT_MODEL=./Qwen3_Merge-596M-F16.gguf

# --- 字幕字体名（需已安装对应字体；ttf 勿提交 git）---
# SUBTITLE_CJK_FONTNAME=Microsoft YaHei
# SUBTITLE_THAI_FONTNAME=Noto Sans Thai

# --- 网关 ---
# GATEWAY_PORT=7860
# GATEWAY_PUBLIC_URL=http://127.0.0.1:7860
# INTERNAL_WORKER_TOKEN=
# ADMIN_USERNAMES=alice,bob

# --- SCNet OAuth（可选；不填则登录入口不可用）---
# SCNET_OAUTH_CLIENT_ID=
# SCNET_OAUTH_CLIENT_SECRET=
# SCNET_OAUTH_REDIRECT_URI=https://your.public.host/

# --- 内容审核（可选；词表文件勿提交 git，见 dict/README.md）---
# ENABLE_CONTENT_SAFETY=0
# CONTENT_SAFETY_DICT_DIR=dict
